# Clerk (https://dashboard.clerk.com → API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Which model checks texts: claude (default) or gemini. Only the chosen one needs a key.
# Without a key the app still starts, and only the free test check ("Testa režīms") works.
# LLM_PROVIDER=claude

# Claude (https://platform.claude.com → API keys)
ANTHROPIC_API_KEY=sk-ant-xxx
# CLAUDE_MODEL=claude-opus-5-5

# Gemini (https://aistudio.google.com → Get API key)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# MongoDB for `npm run dev` (Docker sets its own address for the app container).
MONGODB_URI=mongodb://localhost:27017/grammar-checker

# Encrypts saved texts. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Keep it safe: if it's lost, saved history can't be read.
ENCRYPTION_KEY=

# Stripe, in test mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
# The monthly price of the subscription product (Product catalog → your product → price_...)
STRIPE_PRICE_ID=price_xxx
# Printed by `stripe listen`, or by `docker compose logs stripe` (README, step 7)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe sends users back after paying, for `npm run dev`
# APP_URL=http://localhost:5173

# --- Docker (docker compose up -d --build) ---
# Optional services: "stripe" on your own computer, "https" on the VPS.
COMPOSE_PROFILES=stripe
# The address people open. On the VPS: https://your-domain.lv
# PUBLIC_URL=http://localhost:8080
# The port on your computer (http://localhost:8080)
# APP_PORT=8080
# VPS only: the domain Caddy gets an HTTPS certificate for, e.g. labotajs.lv
# DOMAIN=

# PORT=3001
